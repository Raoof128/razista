{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Observation",
  "description": "A deterministic tool result. An observation, not a confirmed vulnerability.",
  "type": "object",
  "properties": {
    "id": {
      "$ref": "#/$defs/ObservationId"
    },
    "location": {
      "anyOf": [
        {
          "$ref": "#/$defs/SourceSpan"
        },
        {
          "type": "null"
        }
      ]
    },
    "message": {
      "type": "string",
      "maxLength": 1024,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x08\\x0B-\\x1F\\x7F-\\x9F]*$"
    },
    "rule_id": {
      "type": "string",
      "maxLength": 256,
      "minLength": 1,
      "pattern": "^[^\\x00-\\x08\\x0B-\\x1F\\x7F-\\x9F]*$"
    },
    "scanner": {
      "$ref": "#/$defs/Ident"
    },
    "severity": {
      "$ref": "#/$defs/Severity"
    },
    "side": {
      "$ref": "#/$defs/DiffSide"
    },
    "trust": {
      "$ref": "#/$defs/TrustLabel"
    }
  },
  "additionalProperties": false,
  "required": [
    "id",
    "scanner",
    "rule_id",
    "message",
    "severity",
    "side",
    "trust"
  ],
  "$defs": {
    "DiffSide": {
      "type": "string",
      "enum": [
        "base",
        "head",
        "both"
      ]
    },
    "Digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "Ident": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "ObservationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "RepoPath": {
      "description": "Repository-relative path; '%', control characters and invalid UTF-8 bytes are %XX-escaped. '.'/'..' components are rejected by the engine.",
      "type": "string",
      "maxLength": 12288,
      "minLength": 1,
      "pattern": "^[^/\\x00-\\x1F\\x7F-\\x9F][^\\x00-\\x1F\\x7F-\\x9F]*$"
    },
    "Severity": {
      "description": "Impact if the claim holds. Independent of how certain the claim is.",
      "type": "string",
      "enum": [
        "critical",
        "high",
        "medium",
        "low",
        "info"
      ]
    },
    "SourceSpan": {
      "description": "A cited range of reviewed bytes. Lines are 1-based and inclusive.",
      "type": "object",
      "properties": {
        "end_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "file_digest": {
          "$ref": "#/$defs/Digest"
        },
        "path": {
          "$ref": "#/$defs/RepoPath"
        },
        "start_line": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "path",
        "file_digest",
        "start_line",
        "end_line"
      ]
    },
    "TrustLabel": {
      "description": "Provenance label carried with every piece of context and output.",
      "oneOf": [
        {
          "description": "Engine-generated or operator-approved configuration.",
          "type": "string",
          "const": "trusted"
        },
        {
          "description": "Reviewed repository content, including comments and docs.",
          "type": "string",
          "const": "untrusted"
        },
        {
          "description": "Output of a third-party tool or code under test.",
          "type": "string",
          "const": "tool_output"
        },
        {
          "description": "Output of a model.",
          "type": "string",
          "const": "model_output"
        }
      ]
    }
  }
}
