{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "ReviewRequest",
  "type": "object",
  "properties": {
    "caller": {
      "$ref": "#/$defs/CallerId"
    },
    "idempotency_key": {
      "$ref": "#/$defs/IdempotencyKey"
    },
    "preparation_id": {
      "$ref": "#/$defs/PreparationId"
    }
  },
  "additionalProperties": false,
  "required": [
    "preparation_id",
    "idempotency_key",
    "caller"
  ],
  "$defs": {
    "CallerId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "IdempotencyKey": {
      "type": "string",
      "pattern": "^[A-Za-z0-9_-]{8,128}$"
    },
    "PreparationId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    }
  }
}
