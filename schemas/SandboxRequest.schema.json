{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "SandboxRequest",
  "description": "A typed execution request. There is deliberately no command field: the\npreset decides what runs.",
  "type": "object",
  "properties": {
    "limits": {
      "$ref": "#/$defs/ExecutionLimits"
    },
    "preset_id": {
      "$ref": "#/$defs/Ident"
    },
    "snapshot_id": {
      "$ref": "#/$defs/SnapshotId"
    },
    "test_artifact": {
      "anyOf": [
        {
          "$ref": "#/$defs/ArtifactId"
        },
        {
          "type": "null"
        }
      ]
    },
    "variant": {
      "$ref": "#/$defs/SnapshotVariant"
    }
  },
  "additionalProperties": false,
  "required": [
    "preset_id",
    "snapshot_id",
    "variant",
    "limits"
  ],
  "$defs": {
    "ArtifactId": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "ExecutionLimits": {
      "type": "object",
      "properties": {
        "cpu_millis": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "disk_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "memory_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "output_bytes": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "processes": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "wall_time_ms": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "cpu_millis",
        "memory_bytes",
        "wall_time_ms",
        "output_bytes",
        "processes",
        "disk_bytes"
      ]
    },
    "Ident": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{0,63}$"
    },
    "SnapshotId": {
      "type": "string",
      "pattern": "^[0-9a-f]{8}-[0-9a-f]{4}-7[0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$"
    },
    "SnapshotVariant": {
      "type": "string",
      "enum": [
        "base",
        "reviewed",
        "patched"
      ]
    }
  }
}
